{
  "name": "@liquivault/sdk",
  "version": "1.0.0",
  "description": "TypeScript clients and Stellar transactions for the LiquiVault testnet invoice-factoring prototype",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "format": "prettier --write src tests examples *.ts",
    "format:check": "prettier --check src tests examples *.ts",
    "example": "node examples/live_proof.mjs"
  },
  "keywords": [
    "stellar",
    "soroban",
    "rwa",
    "invoice-factoring",
    "liquidity-pool",
    "defi",
    "liquivault",
    "usdc",
    "freighter"
  ],
  "author": "LiquiVault Protocol Contributors",
  "license": "MIT",
  "dependencies": {
    "@stellar/freighter-api": "^2.0.0",
    "@stellar/stellar-sdk": "^17.4.0",
    "buffer": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.1.0",
    "typescript": "^5.5.0",
    "vitest": "5.1.0",
    "vite": "8.3.8",
    "prettier": "3.9.10"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "follow-redirects": "1.16.3",
    "esbuild": "^0.28.1"
  }
}
